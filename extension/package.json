{
  "name": "growdesk-capture-extension",
  "version": "1.0.13",
  "private": true,
  "description": "GrowDesk Capture: Chrome MV3 toolbar that captures leads from WhatsApp Web and Instagram into GrowDesk.",
  "type": "module",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && npm run verify && node scripts/build.mjs",
    "dev": "node scripts/build.mjs --watch",
    "clean": "node scripts/build.mjs --clean-only",
    "verify": "node scripts/verify-logic.mjs",
    "pack": "npm run build && node scripts/pack.mjs",
    "key": "node scripts/make-key.mjs",
    "deploy": "npm run pack && node scripts/deploy.mjs",
    "browser:install": "npx --yes @puppeteer/browsers install chrome@stable --path .browser",
    "start": "npm run build && node scripts/run-chrome.mjs",
    "serve": "node scripts/serve.mjs",
    "release": "npm run build && node scripts/release.mjs",
    "publish:growdesk": "npm run pack && node scripts/publish-growdesk.mjs"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.270",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
